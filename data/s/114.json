[["قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ ١","Кажи [о, Мухаммад]: “Опазил ме Господът на хората,",604,30],["مَلِكِ ٱلنَّاسِ ٢","Владетелят на хората,",604,30],["إِلَٰهِ ٱلنَّاسِ ٣","Богът на хората,",604,30],["مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ ٤","от злото на шепнещия съблазни [сатана], побягващия,",604,30],["ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ ٥","който нашепва в гърдите на хората,",604,30],["مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ ٦","[сатана] от джиновете и от хората!”",604,30]]