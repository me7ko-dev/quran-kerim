[["أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ ١","Видя ли ти онзи, който взима за лъжа Възмездието?",602,30],["فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ ٢","Това е онзи, който пъди сирака",602,30],["وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ٣","и не подканва да бъде нахранен нуждаещият се.",602,30],["فَوَيۡلٞ لِّلۡمُصَلِّينَ ٤","Горко на отслужващите молитва,",602,30],["ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ ٥","които своята молитва [съзнателно] пренебрегват,",602,30],["ٱلَّذِينَ هُمۡ يُرَآءُونَ ٦","които лицемерят,",602,30],["وَيَمۡنَعُونَ ٱلۡمَاعُونَ ٧","а отказват дори дребните услуги!",602,30]]