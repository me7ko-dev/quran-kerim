[["قُلۡ هُوَ ٱللَّهُ أَحَدٌ ١","Кажи [о, Мухаммад]: “Той е Аллах - Единствения,",604,30],["ٱللَّهُ ٱلصَّمَدُ ٢","Аллах, Целта [на всички въжделения]!",604,30],["لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ ٣","Нито е раждал, нито е роден,",604,30],["وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ ٤","и няма равен Нему.”",604,30]]