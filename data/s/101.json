[["ٱلۡقَارِعَةُ ١","Бедствието!",600,30],["مَا ٱلۡقَارِعَةُ ٢","Какво е Бедствието?",600,30],["وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ ٣","И откъде да знаеш ти какво е Бедствието?",600,30],["يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ ٤","Деня, в който хората ще бъдат като пръснати пеперуди",600,30],["وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ ٥","и планините ще бъдат като разпокъсана вълна...",600,30],["فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ٦","Онзи, чиито везни натежат,",600,30],["فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ ٧","ще има живот в доволство,",600,30],["وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ٨","а онзи, чиито везни олекнат,",600,30],["فَأُمُّهُۥ هَاوِيَةٞ ٩","завръщането му е бездна.",600,30],["وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ ١٠","А откъде да знаеш ти какво е тя?",600,30],["نَارٌ حَامِيَةُۢ ١١","Пламтящ огън.",600,30]]