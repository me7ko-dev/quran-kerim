[["أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ١","Не разтворихме ли Ние твоята гръд  [о, Мухаммад]?",596,30],["وَوَضَعۡنَا عَنكَ وِزۡرَكَ ٢","И снехме от теб бремето,",596,30],["ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ ٣","което тегнеше на твоя гръб.",596,30],["وَرَفَعۡنَا لَكَ ذِكۡرَكَ ٤","И възвисихме твоето споменаване.",596,30],["فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا ٥","С трудността има и леснина.",596,30],["إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا ٦","Да, с трудността има и леснина.",596,30],["فَإِذَا فَرَغۡتَ فَٱنصَبۡ ٧","И когато приключиш, [пак] се труди усърдно,",596,30],["وَإِلَىٰ رَبِّكَ فَٱرۡغَب ٨","и на своя Господ се посвещавай!",596,30]]