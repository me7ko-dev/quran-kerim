[["عَبَسَ وَتَوَلَّىٰٓ ١","Той се намръщи и обърна гръб,",585,30],["أَن جَآءَهُ ٱلۡأَعۡمَىٰ ٢","че при него е дошъл слепецът.",585,30],["وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ٣","Но ти откъде знаеш, може да се пречисти.",585,30],["أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ ٤","Или да се поучи, та да му е от полза поуката.",585,30],["أَمَّا مَنِ ٱسۡتَغۡنَىٰ ٥","А онзи, който е безразличен,",585,30],["فَأَنتَ لَهُۥ تَصَدَّىٰ ٦","с него си се заел.",585,30],["وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ ٧","И не е твоя грижа, че не се пречиства.",585,30],["وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ ٨","А от онзи, който е дошъл при теб с упоритост",585,30],["وَهُوَ يَخۡشَىٰ ٩","и е богобоязлив,",585,30],["فَأَنتَ عَنۡهُ تَلَهَّىٰ ١٠","от него ти се отклоняваш.",585,30],["كـَلَّآ إِنَّهَا تَذۡكِرَةٞ ١١","Ала не! Това е поучение",585,30],["فَمَن شَآءَ ذَكَرَهُۥ ١٢","и който пожелае, той се поучава -",585,30],["فِي صُحُفٖ مُّكَرَّمَةٖ ١٣","в Писания почитани,",585,30],["مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ ١٤","въздигнати, пречистени,",585,30],["بِأَيۡدِي سَفَرَةٖ ١٥","[преписани] от ръце на [ангели-] писари",585,30],["كِرَامِۭ بَرَرَةٖ ١٦","достойни, благочестиви.",585,30],["قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ ١٧","Проклет да е човекът! Колко е неблагодарен!",585,30],["مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ١٨","От какво нещо го е сътворил Той?",585,30],["مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩","От частица сперма Той го сътвори и осъразмери.",585,30],["ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ٢٠","После пътя му облекчи.",585,30],["ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ٢١","После го умъртви и повели да бъде погребан.",585,30],["ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ٢٢","После, когато Той пожелае, ще го възкреси.",585,30],["كـَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ ٢٣","Ала не! Не изпълни той Неговата повеля.",585,30],["فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ٢٤","Да погледне човекът своето препитание!",585,30],["أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا ٢٥","Ние проливаме обилно водата.",585,30],["ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا ٢٦","После разпукваме земята",585,30],["فَأَنۢبَتۡنَا فِيهَا حَبّٗا ٢٧","и правим от нея да поникнат зърна",585,30],["وَعِنَبٗا وَقَضۡبٗا ٢٨","и грозде, и зеленина,",585,30],["وَزَيۡتُونٗا وَنَخۡلٗا ٢٩","и маслини, и палми,",585,30],["وَحَدَآئِقَ غُلۡبٗا ٣٠","и гъсти градини,",585,30],["وَفَٰكِهَةٗ وَأَبّٗا ٣١","и плод, и трева -",585,30],["مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ٣٢","за ползване от вас и от вашия добитък.",585,30],["فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ٣٣","И когато Грохотът настъпи,",585,30],["يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ ٣٤","в Деня, когато мъжът избяга от брат си",585,30],["وَأُمِّهِۦ وَأَبِيهِ ٣٥","и от майка си, и от баща си,",585,30],["وَصَٰحِبَتِهِۦ وَبَنِيهِ ٣٦","и от жена си, и от децата си -",585,30],["لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ ٣٧","всеки от тях в този Ден ще е зает с дело, което ще го поглъща.",585,30],["وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ ٣٨","Едни лица в този Ден ще бъдат сияещи,",585,30],["ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ ٣٩","засмени, възрадвани,",585,30],["وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ ٤٠","а по други в този Ден ще има прах,",585,30],["تَرۡهَقُهَا قَتَرَةٌ ٤١","ще ги покрива чернилка.",585,30],["أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ ٤٢","Тези са неверниците, нечестивците.",585,30]]